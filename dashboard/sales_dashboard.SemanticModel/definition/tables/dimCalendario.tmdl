	hierarchy Calendario
		lineageTag: 7d3792c3-3776-4160-a6f7-911456da7dbb

		level Ano
			lineageTag: 8fa5e886-63be-4ce9-bd35-b8d0d7bcb323
			column: Ano

		level Mês
			lineageTag: 8d676628-24eb-458e-824e-4d8f03e049de
			column: MesAno

		level Dia
			lineageTag: ee44f26c-1d24-432c-8323-3d013b6c62f8
			column: Date

	partition dimCalendario = calculated
		mode: import
		source = ```
				
				VAR _DataMin =
				    DATE ( YEAR(MIN('fctSales'[transaction_dt])), 1, 1 )
				VAR _DataMax =
				    DATE ( 2030, 12, 31 )
				VAR _Base =
				    ADDCOLUMNS (
				        CALENDAR ( _DataMin, _DataMax ),
				        "FlagFeriado",
				            SWITCH (
				                TRUE (),
				                MONTH ( [Date] ) = 1 && DAY ( [Date] ) = 1, 1,
				                MONTH ( [Date] ) = 2 && DAY ( [Date] ) = 17, 1,
				                MONTH ( [Date] ) = 3 && DAY ( [Date] ) = 19, 1,
				                MONTH ( [Date] ) = 3 && DAY ( [Date] ) = 25, 1,
				                MONTH ( [Date] ) = 4 && DAY ( [Date] ) = 3, 1,
				                MONTH ( [Date] ) = 4 && DAY ( [Date] ) = 21, 1,
				                MONTH ( [Date] ) = 5 && DAY ( [Date] ) = 1, 1,
				                MONTH ( [Date] ) = 6 && DAY ( [Date] ) = 4, 1,
				                MONTH ( [Date] ) = 8 && DAY ( [Date] ) = 27, 1,
				                MONTH ( [Date] ) = 9 && DAY ( [Date] ) = 7, 1,
				                MONTH ( [Date] ) = 10 && DAY ( [Date] ) = 12, 1,
				                MONTH ( [Date] ) = 10 && DAY ( [Date] ) = 25, 1,
				                MONTH ( [Date] ) = 11 && DAY ( [Date] ) = 2, 1,
				                MONTH ( [Date] ) = 11 && DAY ( [Date] ) = 15, 1,
				                MONTH ( [Date] ) = 11 && DAY ( [Date] ) = 20, 1,
				                MONTH ( [Date] ) = 12 && DAY ( [Date] ) = 25, 1,
				                0
				            )
				    )
				RETURN
				    ADDCOLUMNS (
				        _Base,
				        "Ano", YEAR ( [Date] ),
				        "MesNumero", MONTH ( [Date] ),
				        "Mes", FORMAT ( [Date], "mmmm" ),
				        "MesAno", FORMAT ( [Date], "MMM/yyyy" ),
				        "MesAnoOrdem",
				            YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Trimestre", "T" & QUARTER ( [Date] ),
				        "SemanaAno",
				            "Sem. " & WEEKNUM([Date], 2),
				        "Dia", DAY ( [Date] ),
				        "DiaSemanaNum", WEEKDAY ( [Date], 2 ),
				        "DiaSemana", FORMAT ( [Date], "ddd" ),
				        "DiaUtil",
				            IF ( WEEKDAY ( [Date], 2 ) <= 5 && [FlagFeriado] = 0, 1, 0 )
				    )
				
				```

	annotation PBI_Id = 5aff1384ee1f44bd9f43d8a6aa9bc789

