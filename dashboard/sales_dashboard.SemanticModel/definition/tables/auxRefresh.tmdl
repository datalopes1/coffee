table auxRefresh
	lineageTag: 5ea5dbfc-03b5-497d-880e-34f709ce03d4

	column DataAtualizacao
		dataType: dateTime
		formatString: General Date
		lineageTag: f903b44c-561e-4a96-8098-ea8ab92707b2
		summarizeBy: none
		sourceColumn: DataAtualizacao

		annotation SummarizationSetBy = Automatic

	partition auxRefresh = m
		mode: import
		source =
				let
				    // 1. Pega a data/hora atual em UTC (Padrão Universal)
				    Fonte = DateTimeZone.UtcNow(),
				
				    // 2. Converte para o fuso horário de Brasília (UTC -3)
				    DataHoraBrasilia = DateTimeZone.SwitchZone(Fonte, -3),
				
				    // 3. Remove a informação de fuso para ficar apenas como DateTime (mais limpo visualmente)
				    DataLimpa = DateTimeZone.RemoveZone(DataHoraBrasilia),
				
				    // 4. Converte em tabela para carregar no modelo
				    Tabela = #table(type table [DataAtualizacao = datetime], {{DataLimpa}})
				in
				    Tabela

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

